import seaborn as sns
from sklearn.datasets import make_blobs


X,y = make_blobs(
    n_samples = 1000,
    n_features = 2,
    centers = 4,
    random_state = 42
)


X


sns.scatterplot(x=X[:, 0],y=X[:, 1],c=y)


#k means clustering 
from sklearn.cluster import KMeans



k = 4

kmeans = KMeans(
    n_clusters = k,
    random_state=42
)


labels = kmeans.fit_predict(X)


labels


sns.scatterplot(x=X[:, 0],y=X[:, 1],c=labels)



