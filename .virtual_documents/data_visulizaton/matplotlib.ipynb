import matplotlib.pyplot as plt

movies = [
    "thunder ball in sky",
    "fantastic four",
    "joker",
    "fast & furios",
    "the rock"
]

years = [2009, 2010, 2011, 2012, 2013]
revenue = [1000, 600, 700, 500, 800]

plt.bar(years, revenue, color="green")

plt.title("Movies Revenue")
plt.xlabel("Year")
plt.ylabel("Revenue (in $M)")

# Display revenue on each bar
for i in range(len(years)):
    plt.text(years[i], revenue[i] + 15, str(revenue[i]), ha="center")
plt.ylim(0,max(revenue)+100)
plt.xlim(min(years),max(years) + 5 )    
    
plt.show()



